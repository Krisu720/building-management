# Wspólna konfiguracja (Postgres + DATABASE_URL). Importowana przez apps/server i packages/db.
# Lokalne nadpisania wpisuj do .env / .env.local.
# @defaultSensitive=false @defaultRequired=infer
# ---

# Nazwa projektu Docker Compose — prefiks kontenerów i wolumenów. Zmień, żeby postawić kolejną, niezależną instancję.
COMPOSE_PROJECT_NAME=building-management

# Tag obrazu postgres.
POSTGRES_VERSION=18-alpine

POSTGRES_HOST=localhost

# Port Postgresa wystawiony na hoście.
# @type=port
POSTGRES_PORT=5432

POSTGRES_USER=postgres

# @sensitive
POSTGRES_PASSWORD=local_dev_password

POSTGRES_DB=building_management

# Connection string składany z powyższych. Można go nadpisać w całości (np. zdalna baza).
# @sensitive
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
