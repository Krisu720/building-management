{
  "name": "building-management",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "env:generate": "turbo run env:generate",
    "openapi:generate": "turbo run openapi:generate",
    "db:start": "varlock run -- docker compose up -d --wait",
    "db:stop": "varlock run -- docker compose down",
    "db:generate": "pnpm --filter @building-management/db db:generate",
    "db:migrate": "pnpm --filter @building-management/db db:migrate",
    "db:push": "pnpm --filter @building-management/db db:push",
    "db:studio": "pnpm --filter @building-management/db db:studio"
  },
  "devDependencies": {
    "@building-management/config": "workspace:*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "varlock": "1.23.0"
  },
  "packageManager": "pnpm@12.18.0"
}
