{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "env:generate": "varlock codegen",
    "postinstall": "varlock codegen"
  },
  "dependencies": {
    "@building-management/db": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "^12.4.2",
    "drizzle-orm": "^0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "varlock": "1.23.0"
  },
  "devDependencies": {
    "@building-management/config": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2001",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
