# Konfiguracja aplikacji server. Wspólne zmienne (DATABASE_URL) pochodzą z root .env.schema.
# @import(../../)
# @defaultSensitive=false @defaultRequired=infer
# @generateTsTypes(path=src/env.ts, exposeEnv=local)
# ---

# @type=port
PORT=3000

# openssl rand -base64 32.
# @sensitive
BETTER_AUTH_SECRET=local_dev_secret_change_me_0123456789abcdef

# backend
# @type=url
BETTER_AUTH_URL=http://localhost:3000

# frontend
# @type=url
WEB_URL=http://localhost:3001
