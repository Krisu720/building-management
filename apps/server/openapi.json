          }
        },
        "required": [
          "id",
          "name",
          "address",
          "adminId",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
